ANALYSIS_URL=http://analysis-layer:7000
STORAGE_URL=http://data-storage:8000
LLM_URL=http://host.docker.internal:1234/v1
BENCHMARK_URL=http://benchmark-service:7100
MANAGEMENT_DATA_DIR=/app/data
MANAGEMENT_DATABASE_PATH=/app/data/management.db
MANAGEMENT_MAX_CONCURRENT_JOBS=2
MANAGEMENT_REQUEST_TIMEOUT_SECONDS=10
MANAGEMENT_IMPORT_TIMEOUT_SECONDS=120
MANAGEMENT_ANALYSIS_TIMEOUT_SECONDS=1800
MANAGEMENT_MAX_JOB_DURATION_SECONDS=3600
MANAGEMENT_MAX_JOB_ATTEMPTS=3
MANAGEMENT_STAGE_TIMEOUT_SECONDS=1800
MANAGEMENT_LLM_REQUEST_TIMEOUT_SECONDS=1800
MANAGEMENT_RETRY_BACKOFF_SECONDS=1
MANAGEMENT_RETRY_MAX_DELAY_SECONDS=60
MANAGEMENT_TELEMETRY_RETENTION_DAYS=7
MANAGEMENT_TELEMETRY_CLEANUP_INTERVAL_SECONDS=3600
ANALYSIS_LOG_DIR=/var/log/newsanalysis/analysis
STORAGE_LOG_DIR=/var/log/newsanalysis/data-storage
MANAGEMENT_EVENTS_URL=http://management-service:9000/internal/events
LOG_DIR=/var/log/newsanalysis/management-service
LOG_LEVEL=INFO
LOG_LEVEL_MANAGEMENT_SERVICE=INFO
LOG_LEVEL_MAIN=INFO
LOG_LEVEL_ORCHESTRATION=INFO
LOG_LEVEL_CLIENTS=INFO
