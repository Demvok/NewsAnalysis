LLM_URL=http://host.docker.internal:1234/v1
LLM_MODEL=google/gemma-4-e4b
LLM_REASONING_PARAMETER=chat_template_kwargs.enable_thinking
LLM_REQUEST_TIMEOUT_SECONDS=1800
STORAGE_REQUEST_TIMEOUT_SECONDS=30
STORAGE_URL=http://data-storage:8000
MANAGEMENT_EVENTS_URL=http://management-service:9000/internal/events
TELEMETRY_QUEUE_SIZE=1000
TELEMETRY_BATCH_SIZE=50
TELEMETRY_FLUSH_INTERVAL_SECONDS=0.5
TELEMETRY_SEND_TIMEOUT_SECONDS=1
MANAGEMENT_CAPTURE_LLM_CONTENT=false
PROMPT_VERSION=unversioned
LOG_DIR=/app/logs
LOG_LEVEL=INFO
LOG_LEVEL_ANALYSIS=INFO
LOG_LEVEL_LLM=INFO
LOG_LEVEL_MAIN=INFO
PERSON_MIN_COSINE_SIMILARITY=0.85
PERSON_AUTO_MERGE_COSINE_SIMILARITY=0.93
PERSON_REVIEW_MIN_COSINE_SIMILARITY=0.78
TOPIC_MIN_COSINE_SIMILARITY=0.85
TOPIC_AUTO_MERGE_COSINE_SIMILARITY=0.93
TOPIC_REVIEW_MIN_COSINE_SIMILARITY=0.78
SEMANTIC_SEARCH_TOP_K=5
INCONSISTENCY_MIN_COSINE_SIMILARITY=0.75
INCONSISTENCY_TOP_K=5
MIN_ATTRIBUTION_CONFIDENCE=0.35
MIN_EXTRACTION_CONFIDENCE=0.35
LOW_INFLUENCE_THRESHOLD=0.35
ANALYZE_ORGANIZATIONS=true  
PARALLEL_SPEAKER_ANALYSIS=true
PARALLEL_ANALYSIS_WORKERS=2