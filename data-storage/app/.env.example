DATABASE_URL=postgresql+psycopg://news:change-me@postgres-db:5432/news
EMBEDDING_DIMENSION=768
EMBEDDING_API_KEY=PASTE_GOOGLE_API_KEY_HERE
EMBEDDING_MODEL=gemini-embedding-001
