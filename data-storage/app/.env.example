DATABASE_URL=postgresql+psycopg://news:change-me@postgres-db:5432/news
EMBEDDING_DIMENSION=768
EMBEDDING_API_KEY=fake_api_key
EMBEDDING_MODEL=text-embedding-embeddinggemma-300m
EMBEDDING_URL=http://host.docker.internal:1234/v1
EMBEDDING_REQUEST_TIMEOUT_SECONDS=1800
EMBEDDING_MIN_COSINE_SIMILARITY=0.0
LOG_DIR=/app/logs
LOG_LEVEL=INFO
LOG_LEVEL_DATA_STORAGE=INFO
LOG_LEVEL_MAIN=INFO
MANAGEMENT_EVENTS_URL=http://management-service:9000/internal/events
TELEMETRY_QUEUE_SIZE=1000
TELEMETRY_BATCH_SIZE=50
TELEMETRY_FLUSH_INTERVAL_SECONDS=0.5
TELEMETRY_SEND_TIMEOUT_SECONDS=1
