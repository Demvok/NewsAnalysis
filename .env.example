POSTGRES_PASSWORD=123
LOGS_DIR=./logs

# Shared service logging and telemetry
LOG_LEVEL=INFO
LOG_LEVEL_ANALYSIS=INFO
LOG_LEVEL_DATA_STORAGE=INFO
LOG_LEVEL_MANAGEMENT_SERVICE=INFO
LOG_LEVEL_LLM=INFO
LOG_LEVEL_MAIN=INFO
LOG_LEVEL_ORCHESTRATION=INFO
LOG_LEVEL_CLIENTS=INFO
MANAGEMENT_EVENTS_URL=http://management-service:9000/internal/events
ANALYSIS_URL=http://analysis-layer:7000
STORAGE_URL=http://data-storage:8000
MANAGEMENT_CAPTURE_LLM_CONTENT=false
PROMPT_VERSION=unversioned

# Analysis-layer model and pipeline
LLM_MODEL=google/gemma-4-e4b
LLM_URL=http://host.docker.internal:1234/v1
LLM_REASONING_PARAMETER=chat_template_kwargs.enable_thinking
PARALLEL_SPEAKER_ANALYSIS=true
PARALLEL_ANALYSIS_WORKERS=4
MIN_ATTRIBUTION_CONFIDENCE=0.35
MIN_EXTRACTION_CONFIDENCE=0.35
ANALYZE_ORGANIZATIONS=true

# Data-storage embedding model
EMBEDDING_URL=http://host.docker.internal:1234/v1
EMBEDDING_MODEL=text-embedding-embeddinggemma-300m
EMBEDDING_API_KEY=fake_api_key
EMBEDDING_MIN_COSINE_SIMILARITY=0.0

# Management-service
MANAGEMENT_MAX_CONCURRENT_JOBS=4
MANAGEMENT_REQUEST_TIMEOUT_SECONDS=10
MANAGEMENT_ANALYSIS_TIMEOUT_SECONDS=1800
MANAGEMENT_TELEMETRY_RETENTION_DAYS=7